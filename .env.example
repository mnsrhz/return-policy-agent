# Optional local settings for the Return Policy Agent.
POLICY_DOCS_PATH=policy_docs

# OpenAI answer generation is optional. The deterministic backend still decides
# eligibility, reason codes, missing info, escalation, and citations.
#
# Recommended: copy this file to `.env` and put your real key there.
# `.env` is ignored by git; `.env.example` is not.
USE_OPENAI_LM=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional LangSmith tracing/evaluation settings.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=return-policy-agent-eval
